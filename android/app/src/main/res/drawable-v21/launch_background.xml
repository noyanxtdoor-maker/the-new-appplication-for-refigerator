<?xml version="1.0" encoding="utf-8"?>
<!-- M5: the API 21+ launch window is the approved brand field instead of
     ?android:colorBackground, so dark mode and light mode both start on the
     same surface as the app-owned splash and there is no light or dark flash
     before the first Flutter frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nt_brand_blue" />
</layer-list>
