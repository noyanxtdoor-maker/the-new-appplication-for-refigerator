<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      M5 SPLASH CORRECTION — Android 12+ system splash.

      Android 12 and later ALWAYS draw a platform-controlled launch surface; it
      cannot be removed without risking white/black flashes, so it is configured
      to be nothing more than the opening field of the approved intro splash:

        * the background is `nt_native_blue` — the first stop of the approved
          artwork's own backdrop, i.e. the artwork's top-edge colour — so the
          platform field and the first Flutter frame line up exactly;
        * the icon is deliberately EMPTY (`nt_splash_no_icon`).  A centred emblem
          on this field reproduces the composition of the earlier rejected "old
          splash" and is what the owner sees dominating a cold launch, which
          makes the app look like it shows old splash -> new splash;
        * `windowSplashScreenIconBackgroundColor` is deliberately NOT set, so no
          rounded platform tile is drawn either;
        * `windowBackground` carries the same brand field.

      The approved composition itself is owned by the first Flutter frame.

      `values-night-v31` carries the identical values on purpose: the launch
      surface must not change with the device Light/Dark setting.
    -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/nt_native_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nt_splash_no_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
