<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- M5 P1: Android 12+ always renders a platform splash before Flutter can
         draw. Reuse the owner-approved launcher artwork on the frozen brand
         field so the earliest visible launch surface is branded. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/nt_brand_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
