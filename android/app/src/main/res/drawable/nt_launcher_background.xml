<?xml version="1.0" encoding="utf-8"?>
<!--
  M5 — adaptive launcher icon background layer.

  The adaptive foreground is the approved launcher artwork inside a mask-safe
  margin.  This layer reproduces the artwork's own vertical field (sampled from
  its top and bottom edges) so that margin is a continuous extension of the
  artwork rather than a visibly wrong band under circle, squircle or
  rounded-square masks.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF011237"
        android:startColor="#FF00255F"
        android:type="linear" />
</shape>
