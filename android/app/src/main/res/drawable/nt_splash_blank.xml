<?xml version="1.0" encoding="utf-8"?>
<!-- M5: the Android 12+ splash icon is intentionally transparent.  The
     approved emblem is presented once, by the app-owned full-screen splash, so
     the platform stage stays a clean brand field instead of showing a small
     icon that then jumps in size when the real splash appears. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
