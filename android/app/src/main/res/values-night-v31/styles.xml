<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- M5: night twin of values-v31/styles.xml.  The `night` ui-mode
         qualifier outranks the platform-version qualifier, so without this
         file a device in dark mode on Android 12+ would fall back to the
         values-night LaunchTheme and lose the platform splash branding.  The
         launch surface is deliberately identical in dark mode: the approved
         splash is the same brand field in both appearances. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/nt_brand_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nt_splash_blank</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
