<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      M5 SPLASH CORRECTION — night Android 12+ system splash.

      UI mode (night) outranks platform version during resource selection, so an
      Android 12+ device in Dark mode resolves LaunchTheme from THIS file rather
      than from `values-v31`.  Omitting it would silently drop the system-splash
      configuration in dark mode and let the device fall back to a palette that
      does not match the approved splash.

      The values are the same intent as `values-v31` and must stay so: one launch
      field colour, no icon, in both modes.  See `values-v31/styles.xml` for why
      the icon is deliberately empty.
    -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/nt_native_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nt_splash_no_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
