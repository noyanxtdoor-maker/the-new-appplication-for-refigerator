# ─────────────────────────────────────────────────────────────
# Secrets — never commit. .env.example is the only tracked env file.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
*.mobileprovision
*.cer
service-account*.json
google-services.json
GoogleService-Info.plist
supabase/.temp/
supabase/.branches/
**/secrets/
**/*.secret
**/*_secret*
**/local.properties
key.properties
android/secrets.properties
android/app/secrets.properties

# ─────────────────────────────────────────────────────────────
# Flutter / Dart
# ─────────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.local-toolchain/
.flutter-plugins
.flutter-plugins-dependencies
# Flutter project metadata is pinned and committed for reproducibility.
!.metadata
*.lock.bak
coverage/
doc/api/
**/generated_plugin_registrant.dart

# Generated source is committed and checked for reproducibility in CI.
*.mocks.dart

# Failed golden-test output (accepted goldens ARE committed)
**/failures/

# Android
apps/mobile/android/.gradle/
apps/mobile/android/captures/
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/
*.apk
*.aab
*.iml

# iOS / macOS
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.framework/
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/Flutter/App.framework/
apps/mobile/ios/Flutter/ephemeral/
apps/mobile/ios/Runner/GeneratedPluginRegistrant.*
*.ipa
*.dSYM.zip
xcuserdata/
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# ─────────────────────────────────────────────────────────────
# Node / Next.js (apps/admin)
# ─────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

